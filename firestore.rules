rules_version = '2';

// Paste into Firebase Console > Firestore Database > Rules (or deploy with the Firebase CLI).
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ helpers

    function signedIn() {
      return request.auth != null;
    }

    function agentDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // An active agent (admin or agent): has a users/{uid} profile that is not deactivated.
    function isAgent() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && agentDoc().data.active == true;
    }

    // Staff levels: admin (everything), manager (everything except platform changes), operator (works the orders).
    // Profiles saved with the old role 'agent' count as operators.
    function isAdmin() {
      return isAgent() && agentDoc().data.role == 'admin';
    }

    // Admin or manager: manages the menu, prices, operators and drivers.
    function isManager() {
      return isAgent() && agentDoc().data.role in ['admin', 'manager'];
    }

    function validProperty(p) {
      return p.title is string && p.title.size() > 0 && p.title.size() <= 200
        && p.description is string && p.description.size() <= 10000
        && p.type is string && p.type.size() > 0 && p.type.size() <= 60
        && p.operation in ['sale', 'rent', 'seasonal']
        && p.price is number && p.price >= 0
        && p.currency is string && p.currency.size() == 3
        && p.status in ['active', 'reserved', 'sold']
        && p.location is map
        && p.specs is map
        && p.photos is list && p.photos.size() <= 40
        && (!('featured' in p) || p.featured is bool)
        && (!('weight' in p) || (p.weight is number && p.weight >= 0))
        && (!('unit' in p) || (p.unit is string && p.unit.size() <= 20))
        && (!('inStock' in p) || p.inStock is bool)
        && (!('salePrice' in p) || (p.salePrice is number && p.salePrice >= 0))
        && (!('wholesalePrice' in p) || (p.wholesalePrice is number && p.wholesalePrice >= 0))
        && (!('deliveryAreas' in p) || (p.deliveryAreas is list && p.deliveryAreas.size() >= 1 && p.deliveryAreas.size() <= 3
             && p.deliveryAreas.hasOnly(['Maldonado', 'Montevideo', 'Canelones'])))
        && (!('boxWeight' in p) || (p.boxWeight is number && p.boxWeight > 0))
        && (!('unitWeight' in p) || (p.unitWeight is number && p.unitWeight > 0))
        && (!('boxUnits' in p) || (p.boxUnits is int && p.boxUnits >= 1 && p.boxUnits <= 100000))
        && (!('looseAllowed' in p) || p.looseAllowed is bool)
        && (!('boxPrice' in p) || (p.boxPrice is number && p.boxPrice >= 0))
        && (!('unitPrice' in p) || (p.unitPrice is number && p.unitPrice >= 0))
        && (!('pricingMode' in p) || p.pricingMode in ['por_kilo', 'por_caja', 'por_atado', 'por_unidad', 'por_bolson'])
        && p.agentId is string;
    }

    // ----------------------------------------------------------- properties
    // Public visitors can read active listings. Public queries must include
    // where('status', '==', 'active'), otherwise Firestore rejects the whole query.
    // Only agents write; each agent edits their own listings, admins edit any.

    match /properties/{id} {
      allow read: if resource.data.status == 'active' || isAgent();

      allow create: if isManager()
        && validProperty(request.resource.data)
        && request.resource.data.agentId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isManager()
        && validProperty(request.resource.data)
        && request.resource.data.agentId == resource.data.agentId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isManager();
    }

    // ----------------------------------------------------------- categories
    // Custom product categories (built-in ones live in the app). Public read so the
    // homepage can show their names; only active agents add or delete them.

    match /categories/{id} {
      allow read: if true;
      allow create: if isManager()
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isManager();
    }

    // ------------------------------------------------------------- products
    // The structured menu the ordering flow reads (sizes, gustos, flavors). Public read; only agents write.

    match /products/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    // -------------------------------------------------------------- drivers
    // Delivery drivers. Every staff member can read them (to assign an order); admins and managers add or edit them. Never deleted.

    match /drivers/{id} {
      allow read: if isAgent();
      allow create: if isManager()
        && request.resource.data.keys().hasOnly(['name', 'address', 'idDocument', 'licenseNumber', 'licenseExpiry', 'whatsapp', 'active', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.address is string && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 200
        && request.resource.data.idDocument is string && request.resource.data.idDocument.size() > 0 && request.resource.data.idDocument.size() <= 40
        && request.resource.data.licenseNumber is string && request.resource.data.licenseNumber.size() > 0 && request.resource.data.licenseNumber.size() <= 40
        && request.resource.data.licenseExpiry is string && request.resource.data.licenseExpiry.size() == 10
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() >= 8 && request.resource.data.whatsapp.size() <= 30
        && request.resource.data.active is bool
        && request.resource.data.createdAt == request.time;
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'address', 'idDocument', 'licenseNumber', 'licenseExpiry', 'whatsapp', 'active']);
      allow delete: if false;
    }

    // ------------------------------------------------------------- messages
    // Messages the public sends from the site footer to the management. Anyone can send one (validated);
    // every staff member (admin, manager, operator) reads and answers them and marks them as read. Never deleted.

    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'contact', 'orderRef', 'text', 'status', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.contact is string && request.resource.data.contact.size() > 0 && request.resource.data.contact.size() <= 200
        && (!('orderRef' in request.resource.data)
            || (request.resource.data.orderRef is string && request.resource.data.orderRef.size() <= 40))
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
      allow read: if isAgent();
      allow update: if isAgent()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'read'];
      allow delete: if false;
    }

    // ------------------------------------------------------------- listings
    // Used by the current admin dashboard and the homepage grid.

    match /listings/{id} {
      allow read: if resource.data.published == true || isAgent();
      allow create, update, delete: if isAgent();
    }

    // ---------------------------------------------------------------- leads
    // The public website can create a lead (and nothing else). Agents manage them,
    // but the only fields they can change are status, notes and assignment.

    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly([
            'name', 'email', 'property', 'message', 'status', 'createdAt',
            'propertyId', 'clientName', 'phone', 'channel',
            'unitPrice', 'quantity', 'clientId', 'priceLevelId', 'orderId',
            'paymentMethod', 'taxRate', 'shipping'
          ])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.email is string && request.resource.data.email.size() <= 320
        && request.resource.data.message is string && request.resource.data.message.size() <= 5000
        && (
          ('name' in request.resource.data
            && request.resource.data.name is string && request.resource.data.name.size() <= 200)
          || ('clientName' in request.resource.data
            && request.resource.data.clientName is string && request.resource.data.clientName.size() <= 200)
        )
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string && request.resource.data.phone.size() <= 50))
        && (!('unitPrice' in request.resource.data)
            || (request.resource.data.unitPrice is number
                && request.resource.data.unitPrice >= 0 && request.resource.data.unitPrice < 1000000))
        && (!('quantity' in request.resource.data)
            || (request.resource.data.quantity is int
                && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 99999))
        && (!('clientId' in request.resource.data)
            || (request.resource.data.clientId is string && request.resource.data.clientId.size() <= 64))
        && (!('priceLevelId' in request.resource.data)
            || (request.resource.data.priceLevelId is string && request.resource.data.priceLevelId.size() <= 40))
        && (!('orderId' in request.resource.data)
            || (request.resource.data.orderId is string && request.resource.data.orderId.size() <= 64))
        && (!('paymentMethod' in request.resource.data)
            || request.resource.data.paymentMethod in ['cash', 'card', 'prepaid', 'house_account'])
        && (!('taxRate' in request.resource.data)
            || (request.resource.data.taxRate is number && request.resource.data.taxRate >= 0 && request.resource.data.taxRate <= 100))
        && (!('shipping' in request.resource.data)
            || (request.resource.data.shipping is number && request.resource.data.shipping >= 0 && request.resource.data.shipping < 1000000))
        && (!('channel' in request.resource.data)
            || request.resource.data.channel in ['WhatsApp', 'Portal', 'Direct']);

      allow read: if isAgent();
      // An operator can modify and suspend an order but never delete it.
      allow delete: if isManager();

      allow update: if isAgent()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'notes', 'assignedAgentId', 'quantity', 'unitPrice', 'message',
                       'paymentMethod', 'taxRate', 'shipping', 'driverId', 'driverName', 'driverPay', 'driverPaid', 'fulfillment'])
        && request.resource.data.status in ['new', 'contacted', 'closed', 'assigned', 'completed', 'suspended']
        // Agents can correct an order before confirming it: quantity, price and the order details text.
        && (!('quantity' in request.resource.data)
            || (request.resource.data.quantity is int
                && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 99999))
        && (!('unitPrice' in request.resource.data)
            || (request.resource.data.unitPrice is number
                && request.resource.data.unitPrice >= 0 && request.resource.data.unitPrice < 1000000))
        && request.resource.data.message is string && request.resource.data.message.size() <= 5000
        && (!('driverId' in request.resource.data)
            || (request.resource.data.driverId is string && request.resource.data.driverId.size() <= 64))
        && (!('driverPay' in request.resource.data)
            || (request.resource.data.driverPay is number
                && request.resource.data.driverPay >= 0 && request.resource.data.driverPay < 1000000))
        && (!('driverPaid' in request.resource.data) || request.resource.data.driverPaid is bool)
        && (!('fulfillment' in request.resource.data) || request.resource.data.fulfillment in ['delivery', 'pickup', 'dinein'])
        && (!('driverName' in request.resource.data)
            || (request.resource.data.driverName is string && request.resource.data.driverName.size() <= 120))
        && (!('paymentMethod' in request.resource.data)
            || request.resource.data.paymentMethod in ['cash', 'card', 'prepaid', 'house_account'])
        && (!('taxRate' in request.resource.data)
            || (request.resource.data.taxRate is number
                && request.resource.data.taxRate >= 0 && request.resource.data.taxRate <= 100))
        && (!('shipping' in request.resource.data)
            || (request.resource.data.shipping is number
                && request.resource.data.shipping >= 0 && request.resource.data.shipping < 1000000))
        && (!('notes' in request.resource.data)
            || (request.resource.data.notes is string && request.resource.data.notes.size() <= 2000));
    }

    // --------------------------------------------------------- price levels
    // Five percentage-per-category levels. Staff read them; only admins write.

    match /price_levels/{id} {
      allow read: if isAgent();
      allow create, update: if isAdmin()
        && id in ['level_1', 'level_2', 'level_3', 'level_4', 'level_5']
        && request.resource.data.keys().hasOnly(['name', 'description', 'categoryAdjustments', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.description is string && request.resource.data.description.size() <= 1000
        && request.resource.data.categoryAdjustments is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // -------------------------------------------------------------- clients
    // Wholesale customers are created by admins only (there is no public sign-up).

    match /clients/{id} {
      allow read: if isAgent();
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------- client_access
    // client_access/{token}: what a customer's browser reads with the secret token from its link
    // (or phone + access code). `get` is public but the token is unguessable; listing is staff only.
    // It mirrors the customer's price level so prices update live. Only admins write.

    match /client_access/{token} {
      allow get: if true;
      allow list: if isAgent();
      allow create, delete: if isAdmin();
      // The customer (anyone holding the secret token) may change only their favorites list.
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favorites'])
            && request.resource.data.favorites is list
            && request.resource.data.favorites.size() <= 100);
    }

    // ---------------------------------------------------------------- users
    // users/{uid} is the agent profile. You can read your own; admins read and manage all.
    // Agents may edit their own name, phone and avatar but never their role or active flag.

    // settings/business: the operator's public details (name, address, contact, RUT, hours). Public read; admins write.

    match /settings/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && id == 'business'
        && request.resource.data.keys().hasOnly(['businessName', 'address', 'email', 'whatsapp', 'phone', 'rut', 'license', 'hours', 'instagram', 'facebook', 'youtube', 'logo', 'heroImages', 'heroTitle', 'heroText', 'nosotrosImage', 'nosotrosTitle', 'nosotrosText', 'faqs', 'taxRate', 'deliveryFee', 'saveOrders', 'updatedAt'])
        && request.resource.data.businessName is string && request.resource.data.businessName.size() <= 120
        && request.resource.data.address is string && request.resource.data.address.size() <= 200
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() <= 50
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 50
        && request.resource.data.rut is string && request.resource.data.rut.size() <= 60
        && request.resource.data.license is string && request.resource.data.license.size() <= 120
        && request.resource.data.hours is string && request.resource.data.hours.size() <= 400
        && request.resource.data.instagram is string && request.resource.data.instagram.size() <= 200
        && request.resource.data.facebook is string && request.resource.data.facebook.size() <= 200
        && request.resource.data.youtube is string && request.resource.data.youtube.size() <= 200
        && request.resource.data.logo is string && request.resource.data.logo.size() <= 500
        && request.resource.data.heroImages is list && request.resource.data.heroImages.size() <= 12
        && request.resource.data.heroTitle is string && request.resource.data.heroTitle.size() <= 120
        && request.resource.data.heroText is string && request.resource.data.heroText.size() <= 400
        && request.resource.data.nosotrosImage is string && request.resource.data.nosotrosImage.size() <= 500
        && request.resource.data.nosotrosTitle is string && request.resource.data.nosotrosTitle.size() <= 200
        && request.resource.data.nosotrosText is string && request.resource.data.nosotrosText.size() <= 1500
        && request.resource.data.faqs is list && request.resource.data.faqs.size() <= 12
        && request.resource.data.taxRate is number && request.resource.data.taxRate >= 0 && request.resource.data.taxRate <= 100
        && request.resource.data.deliveryFee is number && request.resource.data.deliveryFee >= 0 && request.resource.data.deliveryFee < 1000000
        && request.resource.data.saveOrders is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // client_pins/{phone}-{pin}: lets a customer sign in with phone + 4-digit PIN. It only holds a pointer
    // to their access token. Reading one entry needs both values; listing is blocked. Only admins write.

    match /client_pins/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());

      // First-admin bootstrap: to create your very first admin profile from the login page,
      // temporarily change this to:
      //   allow create: if isAdmin() || (signedIn() && request.auth.uid == uid
      //                                  && request.resource.data.role == 'admin');
      // then change it back right after you have signed in.
      // Admins add any level; a manager adds operators only. Users are never deleted, only deactivated.
      allow create: if isAdmin()
        || (isManager() && request.resource.data.role == 'operator');

      allow update: if isAdmin()
        || (isManager() && resource.data.role == 'operator' && request.resource.data.role == 'operator'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'name', 'phone']))
        || (isAgent() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'phone', 'avatarUrl']));

      allow delete: if false;
    }
  }
}
